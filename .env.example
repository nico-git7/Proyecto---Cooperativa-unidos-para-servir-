# Copiar a .env y completar. El script deploy/instalar-vps.sh genera las claves automáticamente.

# Dirección pública del sitio (se usa en los enlaces de los correos)
URL_SITIO=https://denuncias.midominio.com.ar

# Puerto donde se publica la web. Con el Nginx del VPS delante (HTTPS) usar 127.0.0.1:8080.
# Sin Nginx en el VPS (solo para probar por IP) usar 80.
WEB_PUERTO=127.0.0.1:8080

# Base de datos
POSTGRES_DB=policia_tucuman
POSTGRES_USER=policia
POSTGRES_PASSWORD=cambiar-por-una-clave-larga

# Firma de las sesiones (mínimo 32 caracteres aleatorios)
JWT_CLAVE=cambiar-por-una-clave-aleatoria-de-al-menos-32-caracteres

# Clave compartida entre la API y el servicio de correo
MAILER_API_KEY=cambiar-por-otra-clave-aleatoria

# Usuario administrador inicial (legajo 10001)
ADMIN_PASSWORD=Tucuman2026
ADMIN_EMAIL=

# true: carga personal, móviles y seis meses de denuncias de ejemplo si la base está vacía
DATOS_DEMO=true

# Documentación interactiva de la API en /api/docs
SWAGGER=true

# Envío de correos con Nodemailer. Con Gmail: activar la verificación en dos pasos y crear una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# Si SMTP_HOST queda vacío, los correos no salen: se guardan como HTML dentro del contenedor mailer.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu.cuenta@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="Policía de Tucumán - Comisaría Virtual <tu.cuenta@gmail.com>"
